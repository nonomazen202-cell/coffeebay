# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.md


# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Custom exclusions
/src/migrations/
/src/scripts/*
!/src/scripts/testing/
/src/scripts/testing/*
!/src/scripts/testing/reset-environment.ts
!/src/scripts/testing/test-utils.ts
!/src/scripts/testing/9-safeguard-simulation-test.ts
/com.md
/task.md
/system_architecture.md
/AGENT.md
/Evolution/
